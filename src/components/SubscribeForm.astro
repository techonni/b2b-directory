<form id="subscribe-form" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-2">
  <label for="email" class="sr-only">Email address</label>
  <input
    id="email"
    name="email"
    type="email"
    required
    autocomplete="email"
    placeholder="Enter your email address"
    class="h-[39px] w-full rounded-[4px] bg-[#e5e5e5] px-3 text-[14px] text-[#171717] outline-none placeholder:text-[#737373] sm:w-[250px]"
  />
  <button
    type="submit"
    class="h-[39px] rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black"
  >
    Subscribe
  </button>
</form>
<script>
  const form = document.getElementById("subscribe-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const note = document.createElement("p");
    note.className = "mt-4 text-[14px] leading-5 text-[#737373]";
    note.textContent = "Noted in this browser. Nothing was sent.";
    form.replaceWith(note);
  });
</script>
