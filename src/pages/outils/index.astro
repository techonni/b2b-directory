---
import Base from "../../layouts/Base.astro";
import ToolRow from "../../components/ToolRow.astro";
import { themes, tools } from "../../lib/guides";
---

<Base title="Outils" description="Les offres Leadpages et HTML Pub citées dans les guides.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Outils</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">
    Les deux familles d'offres de Leadpages. Pour chacune : à qui elle sert, et à quoi faire attention.
  </p>
  {
    themes.map((theme) => {
      const list = tools.filter((tool) => tool.themes[0] === theme.slug);
      if (list.length === 0) return null;
      return (
        <section class="mt-14">
          <h2 class="text-[13px] leading-5 text-[#737373]">{theme.name}</h2>
          <div class="mt-6 space-y-6">
            {list.map((tool) => <ToolRow tool={tool} />)}
          </div>
        </section>
      );
    })
  }
</Base>
