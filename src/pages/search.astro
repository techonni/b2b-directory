---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import ToolRow from "../components/ToolRow.astro";
import { getCategory, tools } from "../lib/directory";

const index = tools.map((tool) => {
  const names = tool.categories.map((slug) => getCategory(slug)?.name ?? "").join(" ");
  return {
    slug: tool.slug,
    haystack: `${tool.name} ${tool.summary} ${names}`.toLowerCase(),
  };
});
---

<Base title="Search" description="Search the directory of B2B software.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Search</h1>
  <SearchForm class="mt-8" />
  <p id="search-prompt" class="mt-10 text-[15px] leading-6 text-[#737373]">
    Type a tool name to search the directory.
  </p>
  <p id="search-empty" class="mt-10 hidden text-[15px] leading-6 text-[#737373]"></p>
  <div id="search-results" class="mt-10 hidden space-y-6">
    {
      tools.map((tool) => (
        <div data-slug={tool.slug}>
          <ToolRow tool={tool} />
        </div>
      ))
    }
  </div>
</Base>

<script define:vars={{ index }}>
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q")?.trim() ?? "";
  const input = document.querySelector("input[name='q']");
  if (input instanceof HTMLInputElement) input.value = query;

  const prompt = document.getElementById("search-prompt");
  const empty = document.getElementById("search-empty");
  const results = document.getElementById("search-results");

  if (prompt && empty && results && query !== "") {
    prompt.classList.add("hidden");
    const needle = query.toLowerCase();
    const matches = new Set(
      index.filter((item) => item.haystack.includes(needle)).map((item) => item.slug),
    );

    if (matches.size === 0) {
      empty.textContent = `No tools matched “${query}”.`;
      empty.classList.remove("hidden");
    } else {
      for (const row of results.querySelectorAll("[data-slug]")) {
        const slug = row.getAttribute("data-slug");
        if (!slug || !matches.has(slug)) row.remove();
      }
      results.classList.remove("hidden");
    }
  }
</script>
