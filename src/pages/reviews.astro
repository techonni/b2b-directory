---
import Base from "../layouts/Base.astro";
import ToolRow from "../components/ToolRow.astro";
import { reviewedTools } from "../lib/directory";

const reviews = reviewedTools();
---

<Base title="Reviews" description="Notes on tools in this directory, newest first.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Reviews</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">
    Notes on tools in this directory, newest first.
  </p>
  {
    reviews.length === 0 ? (
      <p class="mt-16 text-[15px] leading-6 text-[#737373]">No reviews yet.</p>
    ) : (
      <div class="mt-16 space-y-6">
        {reviews.map((tool) => (
          <ToolRow tool={tool} />
        ))}
      </div>
    )
  }
</Base>
