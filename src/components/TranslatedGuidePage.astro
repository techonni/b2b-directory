---
// Page d'un guide traduit (/pt/guias/… ou /en/guides/…). Texte de la traduction ;
// sources et bouton affilié repris du guide français.
import Base from "../layouts/Base.astro";
import { affiliateLink, getGuide, shopifyLink, type Guide } from "../lib/guides";
import NewsletterForm from "./NewsletterForm.astro";
import {
  localizeSource,
  getTranslation,
  guideAlternates,
  listPath,
  translatedPath,
  translations,
  ui,
  type OtherLang,
  type TranslatedGuide,
} from "../lib/i18n";

interface Props {
  lang: OtherLang;
  item: TranslatedGuide;
}

const { lang, item } = Astro.props;
const t = ui[lang];
const guide = getGuide(item.slug) as Guide;
const shop = guide.theme === "boutique";
const other: OtherLang = lang === "pt" ? "en" : "pt";
const otherItem = getTranslation(other, item.slug);
const sources = guide.sources
  .map((source) => localizeSource(lang, source))
  .filter((source): source is { label: string; url: string } => source !== null);
const related = translations[lang].filter((entry) => entry.slug !== item.slug).slice(0, 4);
const minutes = Math.max(1, Math.round(item.steps.map((step) => step.text).join(" ").split(/\s+/).length / 200));
const date = new Intl.DateTimeFormat(lang === "pt" ? "pt-BR" : "en-US", { day: "numeric", month: "long", year: "numeric" }).format(
  new Date(guide.updatedOn),
);
const cta = shop
  ? { href: shopifyLink, tool: "shopify", short: t.ctaShopShort, text: t.ctaShop, label: t.ctaShopLabel }
  : { href: affiliateLink, tool: "leadpages", short: t.ctaPagesShort, text: t.ctaPages, label: t.ctaPagesLabel };

const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: item.question,
  description: item.summary,
  inLanguage: lang === "pt" ? "pt" : "en-US",
  step: item.steps.map((step, index) => ({ "@type": "HowToStep", position: index + 1, name: step.title, text: step.text })),
};
---

<Base
  lang={lang}
  title={item.question}
  description={item.summary}
  image={`/pins/${guide.slug}.jpg`}
  type="article"
  alternates={guideAlternates(item.slug)}
  breadcrumbs={[{ name: t.home, path: listPath(lang) }, { name: item.question }]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howTo)} />

  <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em] text-[#171717]">{item.question}</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">{item.intro}</p>
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] leading-5 text-[#a0a0a0]">
    <p>{t.reading}: {minutes} min</p>
    <p>{t.updated} {date}</p>
    <a href={`/guides/${guide.slug}/`} hreflang="fr" class="text-[#737373] hover:underline">{t.frenchVersion}</a>
    {otherItem ? (
      <a href={translatedPath(other, otherItem.localSlug)} hreflang={other} class="text-[#737373] hover:underline">{t.otherLang}</a>
    ) : null}
    <button
      type="button"
      data-print
      class="no-print inline-flex h-[30px] items-center gap-1.5 rounded-[4px] border border-[#e5e5e5] bg-white px-3 text-[13px] font-medium text-[#171717] hover:bg-[#f3f3f3]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
      {t.downloadPdf}
    </button>
  </div>
  <script>
    document.querySelectorAll("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
  </script>

  <aside class="no-print mt-6 flex flex-col gap-3 rounded-[6px] border border-[#e5e5e5] bg-white p-4 min-[480px]:flex-row min-[480px]:items-center">
    <p class="flex-1 text-[14px] leading-6 text-[#666666]">
      {cta.short} <span class="text-[#a0a0a0]">{t.affiliateShort}</span>
    </p>
    <a
      href={cta.href}
      target="_blank"
      rel="sponsored noopener"
      data-affiliate={cta.tool}
      data-placement={`haut-${lang}`}
      class="inline-flex h-[36px] shrink-0 items-center justify-center rounded-[4px] bg-[#262626] px-4 text-[14px] font-medium text-white hover:bg-black"
    >
      {cta.label}
    </a>
  </aside>

  <section class="mt-10 rounded-[6px] border border-[#e5e5e5] bg-white p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">{t.inShort}</h2>
    <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-[15px] leading-6 text-[#404040]">
      {item.steps.map((step) => <li>{step.title}</li>)}
    </ol>
    {item.pitfalls[0] ? (
      <p class="mt-4 text-[14px] leading-6 text-[#666666]">
        <span class="font-medium text-[#171717]">{t.avoid}</span> {item.pitfalls[0]}
      </p>
    ) : null}
    <a href="#steps" class="no-print mt-4 inline-block text-[14px] font-medium leading-5 text-[#171717] hover:underline">{t.seeDetail}</a>
  </section>

  <section id="steps" class="mt-14 scroll-mt-20">
    <h2 class="text-[13px] leading-5 text-[#737373]">{t.stepByStep}</h2>
    <p class="mt-2 text-[13px] leading-5 text-[#a0a0a0]">{t.uiNote}</p>
    <ol class="mt-6 space-y-8">
      {
        item.steps.map((step, index) => {
          return (
            <li class="flex gap-4">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#171717] text-[13px] font-medium text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-[15px] font-medium leading-6 text-[#171717]">{step.title}</h3>
                {step.text.split("\n\n").map((paragraph, i) => (
                  <p class:list={["text-[15px] leading-6 text-[#666666]", i === 0 ? "mt-1" : "mt-3"]}>{paragraph}</p>
                ))}
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">{t.tryYourself}</h2>
    <p class="mt-3 text-[14px] leading-6 text-[#666666]">{cta.text}</p>
    <a
      href={cta.href}
      target="_blank"
      rel="sponsored noopener"
      data-affiliate={cta.tool}
      data-placement={`bas-${lang}`}
      class="mt-5 inline-flex h-[39px] items-center rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black"
    >
      {cta.label}
    </a>
    <p class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">{t.affiliate}</p>
  </section>

  {
    item.pitfalls.length > 0 ? (
      <section class="mt-14 rounded-[6px] bg-[#fff6e5] p-6">
        <h2 class="text-[15px] font-medium leading-5 text-[#171717]">{t.pitfalls}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-6 text-[#5c4a26]">
          {item.pitfalls.map((pitfall) => <li>{pitfall}</li>)}
        </ul>
      </section>
    ) : null
  }

  {
    sources.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">{t.sources}</h2>
        <ul class="mt-4 space-y-2">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener" class="text-[15px] font-medium leading-6 text-[#171717] hover:underline">
                {source.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <NewsletterForm lang={lang} tag={shop ? "shopify" : "leadpages"} />

  <section class="mt-14">
    <h2 class="text-[13px] leading-5 text-[#737373]">{t.readNext}</h2>
    <div class="mt-6 space-y-8">
      {
        related.map((entry) => (
          <a href={translatedPath(lang, entry.localSlug)} class="group block">
            <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">{entry.question} →</span>
            <span class="mt-1 block text-[14px] leading-5 text-[#737373]">{entry.summary}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
