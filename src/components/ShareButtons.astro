---
// Boutons de partage. Chaque lien partagé porte des paramètres UTM
// (utm_source = réseau, utm_medium = social, utm_campaign = partage-guide, utm_content = guide)
// pour voir dans Google Analytics d'où viennent les visiteurs.
interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
const site = Astro.site ?? new URL("https://zunrel.com");
const pageUrl = new URL(`/guides/${slug}/`, site);
const pinImage = new URL(`/pins/${slug}.jpg`, site).toString();

function withUtm(source: string) {
  const url = new URL(pageUrl);
  url.searchParams.set("utm_source", source);
  url.searchParams.set("utm_medium", "social");
  url.searchParams.set("utm_campaign", "partage-guide");
  url.searchParams.set("utm_content", slug);
  return url.toString();
}

const e = encodeURIComponent;
const links = [
  { platform: "x", label: "X", href: `https://x.com/intent/post?url=${e(withUtm("x"))}&text=${e(title)}` },
  {
    platform: "pinterest",
    label: "Pinterest",
    href: `https://www.pinterest.com/pin/create/button/?url=${e(withUtm("pinterest"))}&media=${e(pinImage)}&description=${e(title)}`,
  },
  { platform: "linkedin", label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${e(withUtm("linkedin"))}` },
  { platform: "whatsapp", label: "WhatsApp", href: `https://wa.me/?text=${e(`${title} ${withUtm("whatsapp")}`)}` },
];
---

<div class="flex flex-wrap items-center gap-2">
  <span class="mr-1 text-[13px] leading-5 text-[#737373]">Partager ce guide</span>
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        data-share={link.platform}
        class="inline-flex h-[30px] items-center rounded-[4px] bg-[#f3f3f3] px-3 text-[13px] text-[#525252] transition-colors hover:bg-[#262626] hover:text-white"
      >
        {link.label}
      </a>
    ))
  }
</div>
