---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import GuideRow from "../components/GuideRow.astro";
import FormatCards from "../components/FormatCards.astro";
import { guidesInTheme, latestGuides, popularGuides, themes } from "../lib/guides";
import { href } from "../lib/paths";
---

<Base
  alternates={[
    { lang: "fr", path: "/" },
    { lang: "pt", path: "/pt/" },
    { lang: "en", path: "/en/" },
  ]}
>
  <p class="text-[13px] leading-5 text-[#737373]">Guides pratiques Leadpages, HTML Pub et Shopify</p>
  <h1 class="mt-3 max-w-[542px] text-[26px] font-semibold leading-8 tracking-[-0.015em] text-[#171717]">
    Leadpages, HTML Pub et Shopify : comment faire, étape par étape.
  </h1>
  <p class="mt-4 max-w-[520px] text-[15px] leading-6 text-[#666666]">
    Des réponses courtes pour créer ses pages avec Leadpages et HTML Pub, puis vendre avec Shopify : choisir son
    offre, créer avec l'IA, connecter son domaine, récolter des contacts, ouvrir sa boutique. Avec les pièges à éviter.
  </p>

  <SearchForm class="mt-12" />

  <FormatCards class="mt-12" />

  <p class="mt-6 text-[13px] leading-5 text-[#737373]">
    Aussi disponible :
    <a href="/pt/" hreflang="pt" class="ml-1 underline underline-offset-4 hover:text-[#171717]">guias em português</a>
    <span class="mx-2" aria-hidden="true">·</span>
    <a href="/en/" hreflang="en" class="underline underline-offset-4 hover:text-[#171717]">guides in English</a>
  </p>

  <a href={href("/offres")} class="mt-10 block rounded-[6px] border border-[#e5e5e5] bg-white p-5 hover:border-[#a0a0a0]">
    <span class="block text-[15px] font-medium leading-5 text-[#171717]">Meilleures offres du moment →</span>
    <span class="mt-1 block text-[14px] leading-5 text-[#737373]">Shopify à 1 € par mois, Leadpages et HTML Pub gratuits pendant 7 jours : les offres vérifiées ce mois-ci.</span>
  </a>

  <section class="mt-[72px]">
    <h2 class="text-[13px] leading-5 text-[#737373]">Nouveaux guides</h2>
    <div class="mt-6 space-y-8">
      {latestGuides().map((guide) => <GuideRow guide={guide} />)}
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-[13px] leading-5 text-[#737373]">Les questions les plus fréquentes</h2>
    <div class="mt-6 space-y-8">
      {popularGuides().map((guide) => <GuideRow guide={guide} />)}
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-[13px] leading-5 text-[#737373]">Par thème</h2>
    <div class="mt-6 space-y-8">
      {
        themes.map((theme) => {
          const count = guidesInTheme(theme.slug).length;
          return (
            <a href={href(`/themes/${theme.slug}`)} class="group block">
              <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
                {theme.name} →
              </span>
              <span class="mt-1 block text-[14px] leading-5 text-[#737373]">
                {theme.blurb} {count} {count === 1 ? "guide" : "guides"}.
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="mt-16 rounded-[6px] bg-[#f3f3f3] p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Comment on écrit ces guides</h2>
    <p class="mt-3 text-[14px] leading-6 text-[#666666]">
      Chaque guide suit le même format : les étapes dans l'ordre, les erreurs fréquentes et les liens vers l'aide
      officielle de chaque outil. Les outils évoluent vite : les noms de boutons et les prix peuvent changer.
    </p>
    <a href={href("/a-propos")} class="mt-4 block text-[14px] font-medium leading-5 text-[#171717] hover:underline">
      En savoir plus →
    </a>
  </section>
</Base>
