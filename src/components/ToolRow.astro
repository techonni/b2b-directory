---
import BrandIcon from "./BrandIcon.astro";
import { href } from "../lib/paths";
import type { Tool } from "../lib/directory";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<a href={href(`/tools/${tool.slug}`)} class="group flex items-center gap-4">
  <BrandIcon slug={tool.slug} name={tool.name} />
  <span class="min-w-0">
    <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
      {tool.name} →
    </span>
    <span class="mt-0.5 block text-[14px] leading-5 text-[#737373]">{tool.summary}</span>
  </span>
</a>
