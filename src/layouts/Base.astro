---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteName, tagline } from "../lib/guides";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title, description = tagline, image = "/pins/creer-sa-boutique-shopify.jpg", type = "website" } = Astro.props;
const imageUrl = new URL(image, Astro.site);

const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1500" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="p:domain_verify" content="485d0834fb682f692cd0c2e316b227a8" />
    <slot name="head" />
    <!-- Google Analytics 4 (Consent Mode : rien n'est stocké avant l'accord du visiteur) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      var zConsent = null;
      try { zConsent = localStorage.getItem("zunrel-consent"); } catch (e) {}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: zConsent === "granted" ? "granted" : "denied",
      });
      gtag("js", new Date());
      gtag("config", "G-KC42X29LL9", { anonymize_ip: true });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KC42X29LL9"></script>
  </head>
  <body class="min-h-full bg-[#fbfbfb] text-[#171717]">
    <SiteHeader />
    <div class="mx-auto w-full max-w-[580px] px-5 min-[620px]:px-0">
      <main class="pt-16">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div
      id="zunrel-consent"
      hidden
      class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-[580px] rounded-lg border border-[#e5e5e5] bg-white p-4 text-sm shadow-lg"
    >
      <p>Nous utilisons Google Analytics pour savoir quels guides sont utiles. Aucune publicité, aucun cookie sans votre accord.</p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="granted" class="rounded-md bg-[#171717] px-3 py-1.5 text-white">Accepter</button>
        <button type="button" data-consent="denied" class="rounded-md border border-[#d4d4d4] px-3 py-1.5">Refuser</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById("zunrel-consent");
        var saved = null;
        try { saved = localStorage.getItem("zunrel-consent"); } catch (e) {}
        if (!saved) box.hidden = false;
        box.addEventListener("click", function (event) {
          var choice = event.target.getAttribute && event.target.getAttribute("data-consent");
          if (!choice) return;
          try { localStorage.setItem("zunrel-consent", choice); } catch (e) {}
          gtag("consent", "update", { analytics_storage: choice });
          box.hidden = true;
        });
      })();
    </script>
  </body>
</html>
