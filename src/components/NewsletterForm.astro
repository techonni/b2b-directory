---
// Inscription à la newsletter avec le formulaire « embedded » de Mailchimp.
// Pas de clé API ni de serveur : le formulaire envoie directement à Mailchimp,
// qui gère la confirmation par e-mail (double opt-in).
// Le bloc ne s'affiche que si `newsletterFormUrl` est rempli dans src/lib/guides.ts.
import { newsletterFormUrl } from "../lib/guides";
---

{
  newsletterFormUrl ? (
    <section class="no-print mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
      <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Recevoir les prochains guides</h2>
      <p class="mt-3 text-[14px] leading-6 text-[#666666]">
        Les nouveaux guides Leadpages, HTML Pub et Shopify par e-mail. Pas de spam, désinscription en un clic.
      </p>
      <form
        action={newsletterFormUrl}
        method="post"
        target="_blank"
        data-newsletter
        class="mt-5 flex flex-col gap-2 min-[480px]:flex-row"
      >
        <label for="newsletter-email" class="sr-only">Adresse e-mail</label>
        <input
          id="newsletter-email"
          type="email"
          name="EMAIL"
          required
          autocomplete="email"
          placeholder="vous@exemple.com"
          class="h-[39px] flex-1 rounded-[4px] bg-white px-3 text-[14px] text-[#171717] outline-none placeholder:text-[#a0a0a0] focus:ring-2 focus:ring-[#171717]"
        />
        <button type="submit" class="h-[39px] rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black">
          S'inscrire
        </button>
      </form>
      <p class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">Vous recevrez un e-mail pour confirmer votre inscription.</p>
    </section>
  ) : null
}
