---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";
---

<Base title="Not found" description="This page is not in the directory.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">
    This page is not in the directory.
  </h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">
    The link may be old, or the tool was never listed.
  </p>
  <a href={href("/")} class="mt-8 block text-[15px] font-medium leading-5 text-[#171717] hover:underline">
    Back to the directory →
  </a>
</Base>
