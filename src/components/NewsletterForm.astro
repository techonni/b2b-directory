---
// Inscription à la newsletter avec le formulaire « embedded » de Mailchimp.
// Pas de clé API ni de serveur : le formulaire envoie directement à Mailchimp,
// qui gère la confirmation par e-mail (double opt-in).
// Le visiteur ne quitte jamais la page : le script envoie l'adresse en arrière-plan
// (point d'accès JSONP « post-json » de Mailchimp) et affiche la réponse dans le bloc.
// Si Mailchimp ne répond pas, le formulaire est envoyé dans une iframe cachée.
// Le bloc ne s'affiche que si `newsletterFormUrl` est rempli dans src/lib/guides.ts.
// Le visiteur choisit son sujet (3 boutons) : le choix part dans le champ `tags` du formulaire,
// et Mailchimp pose la ou les tags correspondantes. « Tout » reçoit les trois tags, donc
// chaque envoi ciblé sur une tag atteint aussi ceux qui veulent tout recevoir.
// `tag` : sujet coché d'avance (celui du guide lu) ; sans `tag`, « Tout » est coché.
import { newsletterFormUrl, newsletterHoneypot, newsletterTags, type NewsletterTag } from "../lib/guides";

interface Props {
  tag?: NewsletterTag;
  title?: string;
  text?: string;
}

const {
  tag,
  title = "Recevoir les prochains guides",
  text = "Les nouveaux guides Leadpages, HTML Pub et Shopify par e-mail, une fois par quinzaine, avec la checklist de lancement Shopify offerte. Pas de spam, désinscription en un clic.",
} = Astro.props;

const interests = [
  { id: "shopify", label: "Shopify", tags: [newsletterTags.shopify] },
  { id: "pages", label: "Leadpages & HTML Pub", tags: [newsletterTags.leadpages, newsletterTags.htmlpub] },
  { id: "tout", label: "Tout", tags: [newsletterTags.shopify, newsletterTags.leadpages, newsletterTags.htmlpub] },
];
const selected = tag === "shopify" ? "shopify" : tag ? "pages" : "tout";
---

{
  newsletterFormUrl ? (
    <section data-newsletter-block class="no-print mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
      <div data-newsletter-intro>
        <h2 class="text-[15px] font-medium leading-5 text-[#171717]">{title}</h2>
        <p class="mt-3 text-[14px] leading-6 text-[#666666]">
          {text}
        </p>
        <form
          action={newsletterFormUrl}
          method="post"
          target="zunrel-newsletter-frame"
          novalidate
          data-newsletter
          class="mt-5"
        >
          <fieldset>
            <legend class="text-[13px] leading-5 text-[#737373]">Je veux recevoir les guides sur</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {interests.map((item) => (
                <label class="inline-flex h-[30px] cursor-pointer items-center rounded-[4px] border border-[#e5e5e5] bg-white px-3 text-[13px] font-medium text-[#404040] transition-colors hover:border-[#a0a0a0] has-checked:border-[#171717] has-checked:bg-[#171717] has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-[#171717] has-focus-visible:ring-offset-2 has-focus-visible:ring-offset-[#f3f3f3]">
                  <input type="radio" name="tags" value={item.tags.join(",")} checked={item.id === selected} class="sr-only" />
                  {item.label}
                </label>
              ))}
            </div>
          </fieldset>
          <div class="mt-4 flex flex-col gap-2 min-[480px]:flex-row">
          <label for="newsletter-email" class="sr-only">Adresse e-mail</label>
          <input
            id="newsletter-email"
            type="email"
            name="EMAIL"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="vous@exemple.com"
            aria-describedby="newsletter-help"
            class="h-[39px] w-full min-w-0 rounded-[4px] min-[480px]:flex-1 bg-white px-3 text-[14px] text-[#171717] outline-none transition-shadow placeholder:text-[#a0a0a0] focus:ring-2 focus:ring-[#171717] aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-[#b42318]"
          />
          <div aria-hidden="true" style="position: absolute; left: -5000px;">
            <input type="text" name={newsletterHoneypot} tabindex="-1" value="" />
          </div>
          <button
            type="submit"
            class="inline-flex h-[39px] min-w-[120px] items-center justify-center gap-2 rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white transition-colors hover:bg-black disabled:cursor-wait"
          >
            <span data-newsletter-spinner hidden class="newsletter-spinner" aria-hidden="true"></span>
            <span data-newsletter-label>S'inscrire</span>
          </button>
          </div>
        </form>
        <p id="newsletter-help" data-newsletter-message aria-live="polite" class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">
          Vous recevrez un e-mail pour confirmer votre inscription.
        </p>
      </div>

      <div data-newsletter-done hidden tabindex="-1" class="newsletter-done flex items-start gap-3 outline-none">
        <span class="mt-[2px] flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#171717]" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path class="newsletter-check" d="M2.5 6.2 5 8.5l4.5-5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div>
          <p data-newsletter-done-title class="text-[15px] font-medium leading-6 text-[#171717]">Merci !</p>
          <p data-newsletter-done-text class="mt-1 text-[14px] leading-6 text-[#666666]"></p>
        </div>
      </div>

      <iframe name="zunrel-newsletter-frame" title="Inscription newsletter" hidden tabindex="-1"></iframe>
    </section>
  ) : null
}

<style>
  .newsletter-spinner {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    animation: newsletter-spin 0.7s linear infinite;
  }
  .newsletter-done:not([hidden]) {
    animation: newsletter-in 0.35s ease-out both;
  }
  .newsletter-done:not([hidden]) .newsletter-check {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    animation: newsletter-draw 0.4s 0.15s ease-out forwards;
  }
  @keyframes newsletter-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes newsletter-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes newsletter-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .newsletter-spinner,
    .newsletter-done:not([hidden]),
    .newsletter-done:not([hidden]) .newsletter-check {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script is:inline>
  (function () {
    var form = document.querySelector("form[data-newsletter]");
    if (!form) return;
    var block = document.querySelector("[data-newsletter-block]");
    var intro = block.querySelector("[data-newsletter-intro]");
    var done = block.querySelector("[data-newsletter-done]");
    var doneTitle = block.querySelector("[data-newsletter-done-title]");
    var doneText = block.querySelector("[data-newsletter-done-text]");
    var message = block.querySelector("[data-newsletter-message]");
    var input = form.querySelector('input[name="EMAIL"]');
    var button = form.querySelector('button[type="submit"]');
    var spinner = button.querySelector("[data-newsletter-spinner]");
    var label = button.querySelector("[data-newsletter-label]");
    var defaultHelp = message.textContent;
    var storageKey = "zunrel-newsletter";

    function remember() {
      try {
        localStorage.setItem(storageKey, "1");
      } catch (e) {}
    }

    function setBusy(busy) {
      button.disabled = busy;
      spinner.hidden = !busy;
      label.textContent = busy ? "Envoi…" : "S'inscrire";
      input.readOnly = busy;
    }

    function setError(text) {
      input.setAttribute("aria-invalid", "true");
      message.textContent = text;
      message.style.color = "#b42318";
      input.focus();
    }

    function clearError() {
      input.removeAttribute("aria-invalid");
      message.textContent = defaultHelp;
      message.style.color = "";
    }

    function showDone(title, text, moveFocus) {
      doneTitle.textContent = title;
      doneText.textContent = text;
      // Garde la hauteur du bloc pour que la page ne saute pas, et centre le message.
      if (moveFocus !== false) block.style.minHeight = block.offsetHeight + "px";
      block.classList.add("flex", "flex-col", "justify-center");
      intro.hidden = true;
      done.hidden = false;
      if (moveFocus !== false) done.focus({ preventScroll: true });
    }

    // Déjà inscrit sur ce navigateur : un simple rappel au lieu du formulaire.
    try {
      if (localStorage.getItem(storageKey) === "1") {
        showDone("Vous êtes inscrit.", "Merci ! Les prochains guides arrivent dans votre boîte mail.", false);
      }
    } catch (e) {}

    input.addEventListener("input", function () {
      if (input.hasAttribute("aria-invalid")) clearError();
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (!input.value.trim() || !input.checkValidity()) {
        // Pas d'envoi : l'événement ne compte pas comme inscription dans les statistiques.
        event.stopPropagation();
        setError("Entrez une adresse e-mail valide, par exemple vous@exemple.com.");
        return;
      }

      var email = input.value.trim();
      var name = "zunrelNewsletter" + Date.now();
      var url = form.action.replace("/subscribe/post?", "/subscribe/post-json?");
      var params = new URLSearchParams(new FormData(form));
      params.set("c", name);
      var script = document.createElement("script");
      var finished = false;

      function finish() {
        finished = true;
        clearTimeout(fallback);
        setBusy(false);
        delete window[name];
        script.remove();
      }

      function success() {
        remember();
        showDone(
          "Merci !",
          "Dernière étape : ouvrez l'e-mail envoyé à " + email + " et cliquez sur le bouton pour confirmer.",
        );
      }

      // Mailchimp ne répond pas : envoi classique dans l'iframe cachée, sans quitter la page.
      function sendInFrame() {
        if (finished) return;
        finish();
        form.submit();
        success();
      }

      var fallback = setTimeout(sendInFrame, 8000);

      window[name] = function (data) {
        if (finished) return;
        finish();
        var msg = (data && data.msg) || "";
        if (data && data.result === "success") {
          success();
        } else if (/already subscribed|déjà inscrit/i.test(msg)) {
          remember();
          showDone("Vous êtes déjà inscrit.", "Merci ! Les prochains guides arrivent dans votre boîte mail.");
        } else if (/too many|trop de/i.test(msg)) {
          setError("Trop de tentatives avec cette adresse. Réessayez dans quelques minutes.");
        } else {
          setError("Cette adresse n'a pas pu être inscrite. Vérifiez-la et réessayez.");
        }
      };

      clearError();
      setBusy(true);
      script.src = url + "&" + params.toString();
      script.onerror = sendInFrame;
      document.body.appendChild(script);
    });
  })();
</script>
