---
import { href } from "../lib/paths";
import { ui, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;

const links = [
  { href: "/guides", label: "Guides" },
  { href: "/outils", label: "Outils" },
  { href: "/offres", label: "Offres du moment" },
  { href: "/newsletter", label: "Newsletter" },
  { href: "/a-propos", label: "À propos" },
  { href: "/kit-media", label: "Kit média" },
  { href: "/conditions-d-utilisation", label: "Conditions" },
];
---

<footer class="mt-28 pb-16">
  {lang === "fr" ? (
  <nav class="flex flex-wrap gap-[11px]">
    {
      links.map((link) => (
        <a
          href={href(link.href)}
          class="inline-flex h-[30px] items-center rounded-[4px] bg-[#f5f5f5] px-3 text-[13px] text-[#666666] hover:text-[#171717]"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  ) : null}
  {lang === "fr" ? (
  <p class="mt-14 max-w-[520px] text-[13px] leading-5 text-[#a0a0a0]">
    Site indépendant, non édité par Leadpages ni Shopify. Informations à vérifier sur les sites officiels avant
    toute décision. Les liens vers Leadpages, HTML Pub et Shopify sont des liens affiliés : ils ne changent pas le prix pour vous.
  </p>
  ) : (
    <p class="max-w-[520px] text-[13px] leading-5 text-[#a0a0a0]">{ui[lang].footer}</p>
  )}
  <p class="mt-2 text-[13px] leading-5 text-[#a0a0a0]">© 2026 Zunrel. Les noms cités appartiennent à leurs propriétaires.</p>
</footer>
