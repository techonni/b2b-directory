---
// Bouton affilié d'un guide. Placé deux fois : en haut (juste après l'intro, version courte)
// et en bas (après les étapes, version complète). `data-placement` part dans l'événement
// GA4 `affiliate_click` pour savoir quel emplacement convertit le mieux.
import { affiliateLink, shopifyLink } from "../lib/guides";

interface Props {
  shop: boolean;
  placement: "haut" | "bas";
}

const { shop, placement } = Astro.props;

// Textes alignés sur ce que les pages officielles affichent (vérifié le 28/09/2026).
const cta = shop
  ? {
      href: shopifyLink,
      tool: "shopify",
      short: "Pour suivre ce guide, il vous faut une boutique Shopify : l'inscription est gratuite, puis 1 € par mois avec l'offre de lancement.",
      text: "Shopify se lance gratuitement, puis l'offre de lancement continue à 1 € par mois. Vous pouvez tout préparer avant de payer.",
      label: "Essayer Shopify ↗",
    }
  : {
      href: affiliateLink,
      tool: "leadpages",
      short: "Pour suivre ce guide, il vous faut un compte Leadpages ou HTML Pub : chaque offre s'essaie gratuitement pendant 7 jours.",
      text: "Toutes les offres HTML Pub et Leadpages s'essaient gratuitement pendant 7 jours, avec toutes leurs fonctions.",
      label: "Essayer Leadpages 7 jours ↗",
    };
---

{
  placement === "haut" ? (
    <aside data-pagefind-ignore class="no-print mt-6 flex flex-col gap-3 rounded-[6px] border border-[#e5e5e5] bg-white p-4 min-[480px]:flex-row min-[480px]:items-center">
      <p class="flex-1 text-[14px] leading-6 text-[#666666]">
        {cta.short} <span class="text-[#a0a0a0]">Lien affilié.</span>
      </p>
      <a
        href={cta.href}
        target="_blank"
        rel="sponsored noopener"
        data-affiliate={cta.tool}
        data-placement="haut"
        class="inline-flex h-[36px] shrink-0 items-center justify-center rounded-[4px] bg-[#262626] px-4 text-[14px] font-medium text-white hover:bg-black"
      >
        {cta.label}
      </a>
    </aside>
  ) : (
    <section data-pagefind-ignore class="mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
      <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Essayer par vous-même</h2>
      <p class="mt-3 text-[14px] leading-6 text-[#666666]">{cta.text}</p>
      <a
        href={cta.href}
        target="_blank"
        rel="sponsored noopener"
        data-affiliate={cta.tool}
        data-placement="bas"
        class="mt-5 inline-flex h-[39px] items-center rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black"
      >
        {cta.label}
      </a>
      <p class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">Lien affilié : il ne change pas le prix pour vous.</p>
    </section>
  )
}
