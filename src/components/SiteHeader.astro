---
import DottedMark from "./DottedMark.astro";
import { href } from "../lib/paths";

const path = Astro.url.pathname;
const links = [
  { href: "/guides", label: "Guides" },
  { href: "/outils", label: "Outils" },
  { href: "/a-propos", label: "À propos" },
];

function isCurrent(target: string) {
  if (target === "/guides") return path.startsWith("/guides") || path.startsWith("/themes");
  return path.startsWith(target);
}
---

<header class="px-6 py-6 sm:px-8">
  <div class="flex items-center justify-between">
    <a href={href("/")} aria-label="Accueil" class="flex items-center gap-2 text-[#171717]">
      <DottedMark />
      <span class="text-[15px] font-semibold tracking-[-0.01em]">Zunrel</span>
    </a>
    <nav class="flex items-center gap-5 text-[14px] leading-5 sm:gap-6">
      {
        links.map((link) => {
          const current = isCurrent(link.href);
          return (
            <a
              href={href(link.href)}
              aria-current={current ? "page" : undefined}
              class={current ? "text-[#0f4bf1]" : "text-[#171717] hover:opacity-70"}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
