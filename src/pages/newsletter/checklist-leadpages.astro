---
// Cadeau de la newsletter (thème Leadpages & HTML Pub) : checklist imprimable (bouton « Télécharger en PDF »).
// Chaque étape renvoie vers le guide qui l'explique en détail.
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getGuide } from "../../lib/guides";

const items = [
  { slug: "essayer-leadpages-gratuitement", task: "Ouvrir l'essai gratuit de 7 jours" },
  { slug: "choisir-entre-html-pub-et-leadpages", task: "Choisir entre HTML Pub et Leadpages selon votre besoin" },
  { slug: "creer-une-landing-page-avec-l-ia", task: "Créer la page avec l'IA, ou partir d'un modèle" },
  { slug: "modifier-l-adresse-d-une-page-leadpages", task: "Donner à la page un titre et une adresse courte" },
  { slug: "connecter-son-nom-de-domaine-leadpages", task: "Connecter votre nom de domaine" },
  { slug: "recolter-des-e-mails-avant-un-lancement", task: "Offrir une vraie raison de laisser son e-mail" },
  { slug: "connecter-leadpages-a-son-outil-e-mail", task: "Relier le formulaire à votre outil d'e-mails" },
  { slug: "recuperer-les-formulaires-html-pub", task: "Tester le formulaire et retrouver le contact reçu" },
  { slug: "faire-un-test-ab-leadpages", task: "Préparer un premier test A/B" },
  { slug: "lire-une-carte-de-chaleur-leadpages", task: "Regarder où les visiteurs cliquent" },
].map((item) => ({ ...item, guide: getGuide(item.slug) }));
---

<Base
  title="Checklist : lancer sa première landing page"
  description="Les 10 étapes à cocher pour lancer votre première landing page Leadpages ou HTML Pub, avec un guide pas à pas pour chacune. À imprimer ou enregistrer en PDF."
>
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Checklist : lancer sa première landing page</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">
    Les 10 étapes à cocher pour lancer une landing page Leadpages ou HTML Pub qui récolte des contacts, dans l'ordre. Chaque étape renvoie vers un guide détaillé.
  </p>
  <div class="mt-6">
    <button
      type="button"
      data-print
      class="no-print inline-flex h-[30px] items-center gap-1.5 rounded-[4px] border border-[#e5e5e5] bg-white px-3 text-[13px] font-medium text-[#171717] hover:bg-[#f3f3f3]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
      Télécharger en PDF
    </button>
  </div>
  <script>
    document.querySelectorAll("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
  </script>

  <ol class="mt-10 space-y-4">
    {
      items.map((item, index) => (
        <li class="flex items-start gap-3 rounded-[6px] border border-[#e5e5e5] bg-white p-4">
          <span
            aria-hidden="true"
            class="mt-[2px] h-5 w-5 shrink-0 rounded-[4px] border-2 border-[#171717]"
          />
          <div>
            <p class="text-[15px] font-medium leading-6 text-[#171717]">
              {index + 1}. {item.task}
            </p>
            {item.guide ? (
              <a
                href={`/guides/${item.slug}/`}
                class="mt-1 inline-block text-[14px] leading-6 text-[#666666] underline underline-offset-4 hover:text-[#171717]"
              >
                {item.guide.question}
              </a>
            ) : null}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-10 text-[13px] leading-5 text-[#a0a0a0]">
    Les offres, prix et libellés de Leadpages et HTML Pub changent souvent : vérifiez-les sur le site officiel avant de décider.
  </p>

  <NewsletterForm tag="leadpages" />
</Base>
