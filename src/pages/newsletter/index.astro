---
// Page d'inscription à la newsletter (lien du pied de page et des réseaux sociaux).
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import GuideRow from "../../components/GuideRow.astro";
import { guides } from "../../lib/guides";

const latest = [...guides].sort((a, b) => b.updatedOn.localeCompare(a.updatedOn)).slice(0, 3);
---

<Base
  title="Newsletter"
  description="Les nouveaux guides Leadpages, HTML Pub et Shopify par e-mail, une fois par quinzaine, avec la checklist de lancement Shopify offerte."
>
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">La newsletter Zunrel</h1>
  <div class="mt-4 space-y-4 text-[15px] leading-6 text-[#666666]">
    <p>
      Un e-mail par quinzaine avec les nouveaux guides : créer une page avec Leadpages ou HTML Pub, ouvrir et faire
      grandir une boutique Shopify. Chaque guide répond à une seule question, étape par étape.
    </p>
    <p>
      En cadeau : la <a href="/newsletter/checklist-shopify/" class="text-[#171717] underline underline-offset-4 hover:text-black">checklist
      de lancement Shopify</a>, les 10 étapes à cocher avant d'ouvrir votre boutique.
    </p>
    <p>Pas de spam, pas de revente de votre adresse. Désinscription en un clic depuis chaque e-mail.</p>
  </div>

  <NewsletterForm title="S'inscrire" text="Votre adresse e-mail suffit. Vous recevrez un e-mail pour confirmer." />

  <section class="mt-14">
    <h2 class="text-[13px] leading-5 text-[#737373]">Les derniers guides</h2>
    <div class="mt-6 space-y-8">
      {latest.map((guide) => <GuideRow guide={guide} />)}
    </div>
  </section>
</Base>
