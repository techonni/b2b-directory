{
  // zunrel.com no Cloudflare (Worker "zunrel" com ficheiros estáticos).
  // O domínio zunrel.com está ligado a este Worker, não ao projeto Pages.
  // Publicar: npm run build && npx wrangler deploy
  "name": "zunrel",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
