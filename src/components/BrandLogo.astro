---
import { logoPath, type Tool } from "../lib/guides";

interface Props {
  tool: Tool;
  size?: "sm" | "lg";
}

const { tool, size = "sm" } = Astro.props;
const src = logoPath(tool);
const fit = tool.logo?.fit ?? "contain";
const zoom = tool.logo?.zoom;
const box = size === "lg" ? "size-[64px] rounded-[16px]" : "size-[48px] rounded-[12px]";
const letter = size === "lg" ? "text-[24px]" : "text-[18px]";
---

<span
  class:list={[
    "relative flex shrink-0 items-center justify-center overflow-hidden bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.05)]",
    box,
  ]}
  aria-hidden="true"
>
  <span class:list={["font-semibold text-[#171717]", letter]}>{tool.name.slice(0, 1)}</span>
  {
    src ? (
      <img
        src={src}
        alt=""
        loading="lazy"
        decoding="async"
        width="64"
        height="64"
        onerror="this.remove()"
        style={zoom ? `transform: scale(${zoom})` : undefined}
        class:list={[
          "absolute inset-0 size-full bg-white",
          fit === "cover" ? "object-cover" : "object-contain p-[18%]",
        ]}
      />
    ) : null
  }
</span>
