---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import ToolRow from "../components/ToolRow.astro";
import { avatarSrc } from "../lib/avatar";
import {
  curator,
  featuredCategories,
  popularTools,
  reviewedTools,
  toolCount,
} from "../lib/directory";
import { href } from "../lib/paths";

const latest = reviewedTools().slice(0, 3);
---

<Base>
  <img
    src={avatarSrc}
    alt={curator}
    width="100"
    height="100"
    class="size-[100px] rounded-[8px] object-cover"
  />
  <h1 class="mt-6 max-w-[542px] text-[22px] font-semibold leading-7 tracking-[-0.011em] text-[#171717]">
    A directory of B2B software, curated by {curator}.
  </h1>
  <p class="mt-3 text-[14px] leading-5 text-[#666666]">I make stuff on the internet.</p>

  <SearchForm class="mt-24" />

  <section class="mt-[72px]">
    <h2 class="text-[13px] leading-5 text-[#737373]">Categories</h2>
    <div class="mt-8 space-y-10">
      {
        featuredCategories().map((category) => {
          const count = toolCount(category.slug);
          return (
            <a href={href(`/categories/${category.slug}`)} class="group block">
              <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
                {category.name} →
              </span>
              <span class="mt-1 block text-[14px] leading-5 text-[#737373]">
                {category.blurb} {count} {count === 1 ? "tool" : "tools"}.
              </span>
            </a>
          );
        })
      }
      <a href={href("/categories")} class="block text-[15px] font-medium leading-5 text-[#171717] hover:underline">
        See all categories →
      </a>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-[13px] leading-5 text-[#737373]">Popular tools</h2>
    <div class="mt-6 space-y-6">
      {popularTools().map((tool) => <ToolRow tool={tool} />)}
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-[13px] leading-5 text-[#737373]">Latest reviews</h2>
    <div class="mt-6 space-y-6">
      {latest.map((tool) => <ToolRow tool={tool} />)}
    </div>
    <a href={href("/reviews")} class="mt-8 block text-[15px] font-medium leading-5 text-[#171717] hover:underline">
      See all reviews →
    </a>
  </section>

  <section class="mt-16">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Directory notes</h2>
    <p class="mt-3 max-w-[520px] text-[14px] leading-5 text-[#737373]">
      Occasional notes on tools added to this directory. Nothing on this form is sent anywhere.
    </p>
    <SubscribeForm />
    <a href={href("/reviews")} class="mt-5 block text-[15px] font-medium leading-5 text-[#171717] hover:underline">
      Read the latest reviews →
    </a>
  </section>
</Base>
