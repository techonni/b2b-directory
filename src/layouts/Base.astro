---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { siteName, tagline } from "../lib/guides";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title, description = tagline, image = "/pins/creer-sa-boutique-shopify.jpg", type = "website" } = Astro.props;
const imageUrl = new URL(image, Astro.site);

const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1500" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="p:domain_verify" content="485d0834fb682f692cd0c2e316b227a8" />
    <GoogleAnalytics />
    <slot name="head" />
  </head>
  <body class="min-h-full bg-[#fbfbfb] text-[#171717]">
    <SiteHeader />
    <div class="mx-auto w-full max-w-[580px] px-5 min-[620px]:px-0">
      <main class="pt-16">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
