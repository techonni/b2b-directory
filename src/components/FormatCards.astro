---
// Les rubriques par format (express, complets). Seules celles qui contiennent des guides s'affichent :
// la rubrique « Guides complets » apparaîtra toute seule le jour où le premier guide long sera publié.
import { activeFormats, guidesInFormat } from "../lib/guides";
import { href } from "../lib/paths";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = activeFormats();
---

<div class:list={["grid gap-3", items.length > 1 ? "min-[480px]:grid-cols-2" : "", className]}>
  {
    items.map((item) => {
      const count = guidesInFormat(item.format).length;
      return (
        <a
          href={href(`/formats/${item.slug}`)}
          class="group block rounded-[6px] bg-[#f3f3f3] p-5 transition-colors hover:bg-[#ebebeb]"
        >
          <span class="block text-[13px] leading-5 text-[#737373]">{item.label}</span>
          <span class="mt-1 block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
            {item.name} →
          </span>
          <span class="mt-2 block text-[14px] leading-5 text-[#666666]">{item.blurb}</span>
          <span class="mt-3 block text-[13px] leading-5 text-[#a0a0a0]">
            {count} {count === 1 ? "guide" : "guides"}
          </span>
        </a>
      );
    })
  }
</div>
