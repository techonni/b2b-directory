---
import Base from "../../layouts/Base.astro";
import GuideRow from "../../components/GuideRow.astro";
import ToolRow from "../../components/ToolRow.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { trackGuideView } from "../../lib/ga-events";
import {
  affiliateLink,
  shopifyLink,
  formatDate,
  getGuide,
  getTheme,
  getTool,
  guides,
  type Guide,
  type Tool,
} from "../../lib/guides";
import { href } from "../../lib/paths";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug } }));
}

const guide = getGuide(Astro.params.slug as string) as Guide;
const theme = getTheme(guide.theme);
const tools = guide.tools
  .map((item) => ({ tool: getTool(item.slug), why: item.why }))
  .filter((item): item is { tool: Tool; why: string } => item.tool !== undefined);
const related = guide.related
  .map((slug) => getGuide(slug))
  .filter((item): item is Guide => item !== undefined);

const isShop = guide.theme === "boutique";
const cta = isShop
  ? {
      href: shopifyLink,
      text: "Shopify s'essaie gratuitement pendant 3 jours, puis l'offre de lancement continue à 1 € par mois pendant 3 mois.",
      label: "Essayer Shopify ↗",
    }
  : {
      href: affiliateLink,
      text: "Toutes les offres HTML Pub et Leadpages s'essaient gratuitement pendant 7 jours, avec toutes leurs fonctions.",
      label: "Essayer Leadpages 7 jours ↗",
    };

const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: guide.question,
  description: guide.summary,
  inLanguage: "fr-FR",
  step: guide.steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.text,
  })),
};
---

<Base title={guide.question} description={guide.summary} image={`/pins/${guide.slug}.jpg`} type="article">
  <meta property="article:published_time" content={guide.updatedOn} slot="head" />
  <meta property="article:author" content="Zunrel" slot="head" />
  {theme && <meta property="article:tag" content={theme.name} slot="head" />}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howTo)} />
  <script define:vars={{ guideSlug: guide.slug, guideTheme: theme?.slug || "unknown" }} slot="head">
    // Track guide view
    if (typeof window !== "undefined" && (window as any).gtag) {
      (window as any).gtag("event", "guide_view", {
        guide: guideSlug,
        theme: guideTheme,
      });
    }
  </script>

  <p class="print-only hidden text-[13px] leading-5 text-[#737373]">Zunrel · zunrel.com/guides/{guide.slug}/</p>
  {
    theme ? (
      <a href={href(`/themes/${theme.slug}`)} class="text-[13px] leading-5 text-[#737373] hover:underline">
        {theme.name}
      </a>
    ) : null
  }
  <h1 class="mt-3 text-[26px] font-semibold leading-8 tracking-[-0.015em] text-[#171717]">{guide.question}</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">{guide.intro}</p>

  <div class="no-print mt-6 border-t border-[#e5e5e5] pt-4">
    <ShareButtons title={guide.question} url={Astro.url.href} description={guide.summary} />
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="text-[13px] leading-5 text-[#a0a0a0]">Mis à jour le {formatDate(guide.updatedOn)}</p>
    <button
      type="button"
      data-print
      class="no-print inline-flex h-[30px] items-center gap-1.5 rounded-[4px] border border-[#e5e5e5] bg-white px-3 text-[13px] font-medium text-[#171717] hover:bg-[#f3f3f3]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
      Télécharger en PDF
    </button>
  </div>
  <script define:vars={{ guideSlug: guide.slug }}>
    document.querySelectorAll("[data-print]").forEach((button) => {
      button.addEventListener("click", () => {
        // Track PDF download
        if (typeof window !== "undefined" && (window as any).gtag) {
          (window as any).gtag("event", "pdf_download", {
            guide: guideSlug,
          });
        }
        window.print();
      });
    });

    // Track affiliate link clicks
    document.querySelectorAll("[data-affiliate]").forEach((link) => {
      link.addEventListener("click", () => {
        const affiliate = link.getAttribute("data-affiliate");
        const guideAttr = link.getAttribute("data-guide");
        if (typeof window !== "undefined" && (window as any).gtag) {
          (window as any).gtag("event", "affiliate_click", {
            tool: affiliate,
            guide: guideAttr,
            context: "cta",
          });
        }
      });
    });
  </script>

  <section class="mt-14">
    <h2 class="text-[13px] leading-5 text-[#737373]">Étape par étape</h2>
    <ol class="mt-6 space-y-8">
      {
        guide.steps.map((step, index) => (
          <li class="flex gap-4">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#171717] text-[13px] font-medium text-white">
              {index + 1}
            </span>
            <div>
              <h3 class="text-[15px] font-medium leading-6 text-[#171717]">{step.title}</h3>
              <p class="mt-1 text-[15px] leading-6 text-[#666666]">{step.text}</p>
              {step.image ? (
                <img
                  src={step.image.src}
                  alt={step.image.alt}
                  loading="lazy"
                  decoding="async"
                  class="mt-4 w-full rounded-[6px] shadow-[0_0_0_1px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.05)]"
                />
              ) : null}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Essayer par vous-même</h2>
    <p class="mt-3 text-[14px] leading-6 text-[#666666]">
      {cta.text}
    </p>
    <a
      href={cta.href}
      target="_blank"
      rel="sponsored noopener"
      class="mt-5 inline-flex h-[39px] items-center rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black"
      data-affiliate={isShop ? "shopify" : "leadpages"}
      data-guide={guide.slug}
    >
      {cta.label}
    </a>
    <p class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">Lien affilié : il ne change pas le prix pour vous.</p>
  </section>

  {
    guide.pitfalls.length > 0 ? (
      <section class="mt-14 rounded-[6px] bg-[#fff6e5] p-6">
        <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Erreurs fréquentes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-6 text-[#5c4a26]">
          {guide.pitfalls.map((pitfall) => <li>{pitfall}</li>)}
        </ul>
      </section>
    ) : null
  }

  {
    tools.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">Outils utiles</h2>
        <div class="mt-6 space-y-6">
          {tools.map((item) => <ToolRow tool={item.tool} note={item.why} />)}
        </div>
      </section>
    ) : null
  }

  {
    guide.sources.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">Sources officielles</h2>
        <ul class="mt-4 space-y-2">
          {guide.sources.map((source) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noopener"
                class="text-[15px] font-medium leading-6 text-[#171717] hover:underline"
              >
                {source.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section class="no-print mt-14">
    <NewsletterForm />
  </section>

  {
    related.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">À lire ensuite</h2>
        <div class="mt-6 space-y-8">
          {related.map((item) => <GuideRow guide={item} />)}
        </div>
      </section>
    ) : null
  }
</Base>
