---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Breadcrumbs, { type Crumb } from "../components/Breadcrumbs.astro";
import { href } from "../lib/paths";
import { siteName, tagline } from "../lib/guides";
import { locales, ui, type Lang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  // Fil d'Ariane affiché au-dessus du titre, avec ses données structurées BreadcrumbList.
  breadcrumbs?: Crumb[];
  // Langue de la page (français par défaut) et versions dans les autres langues (hreflang).
  lang?: Lang;
  alternates?: { lang: Lang; path: string }[];
}

const {
  title,
  description = tagline,
  image = "/pins/creer-sa-boutique-shopify.jpg",
  type = "website",
  breadcrumbs,
  lang = "fr",
  alternates,
} = Astro.props;
const t = ui[lang];
const imageUrl = new URL(image, Astro.site);

const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const breadcrumbList = breadcrumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: crumb.path ? new URL(href(crumb.path), Astro.site).href : canonical.href,
  })),
};
---

<!doctype html>
<html lang={lang} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="impact-site-verification" content="1eabb491-b11d-43a2-a3ae-0a20046de4bc" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1500" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={locales[lang]} />
    {
      alternates
        ? [
            ...alternates.map((item) => <link rel="alternate" hreflang={item.lang} href={new URL(item.path, Astro.site)} />),
            <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].path, Astro.site)} />,
          ]
        : null
    }
    <meta name="p:domain_verify" content="485d0834fb682f692cd0c2e316b227a8" />
    {breadcrumbList ? <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} /> : null}
    <slot name="head" />
    <!-- Google Analytics 4 (Consent Mode : rien n'est stocké avant l'accord du visiteur) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      var zConsent = null;
      try { zConsent = localStorage.getItem("zunrel-consent"); } catch (e) {}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: zConsent === "granted" ? "granted" : "denied",
      });
      gtag("js", new Date());
      gtag("config", "G-KC42X29LL9", { anonymize_ip: true });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KC42X29LL9"></script>
    <!-- Vercel Web Analytics (sans cookies) : visites lues par Claude Code avec l'outil Vercel. -->
    <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="min-h-full bg-[#fbfbfb] text-[#171717]">
    <SiteHeader lang={lang} alternates={alternates} />
    <div class="mx-auto w-full max-w-[580px] px-5 min-[620px]:px-0">
      <main class="pt-16">
        {breadcrumbs ? <Breadcrumbs items={breadcrumbs} /> : null}
        <slot />
      </main>
      <SiteFooter lang={lang} />
    </div>
    <div
      id="zunrel-consent"
      hidden
      class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-[580px] rounded-lg border border-[#e5e5e5] bg-white p-4 text-sm shadow-lg"
    >
      <p>{t.consent}</p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="granted" class="rounded-md bg-[#171717] px-3 py-1.5 text-white">{t.accept}</button>
        <button type="button" data-consent="denied" class="rounded-md border border-[#d4d4d4] px-3 py-1.5">{t.refuse}</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById("zunrel-consent");
        var saved = null;
        try { saved = localStorage.getItem("zunrel-consent"); } catch (e) {}
        if (!saved) box.hidden = false;
        box.addEventListener("click", function (event) {
          var choice = event.target.getAttribute && event.target.getAttribute("data-consent");
          if (!choice) return;
          try { localStorage.setItem("zunrel-consent", choice); } catch (e) {}
          gtag("consent", "update", { analytics_storage: choice });
          box.hidden = true;
          if (choice === "granted") window.zunrelVitals();
        });
      })();
    </script>
    <!-- Événements Google Analytics : clics affiliés, partages, PDF, newsletter -->
    <script is:inline>
      (function () {
        var guide = (location.pathname.match(/^\/(?:(?:pt|en)\/)?gui(?:de|a)s\/([^/]+)/) || [])[1] || "";
        document.addEventListener("click", function (event) {
          var el = event.target.closest && event.target.closest("a, button");
          if (!el) return;
          if (el.matches('a[rel~="sponsored"]')) {
            gtag("event", "affiliate_click", {
              tool: el.getAttribute("data-affiliate") || el.hostname,
              placement: el.getAttribute("data-placement") || "autre",
              guide: guide,
              page: location.pathname,
              link_url: el.href,
            });
          } else if (el.hasAttribute("data-share")) {
            gtag("event", "share", { method: el.getAttribute("data-share"), content_type: "guide", item_id: guide });
          } else if (el.hasAttribute("data-print")) {
            gtag("event", "pdf_download", { guide: guide });
          }
        });
        document.addEventListener("submit", function (event) {
          if (event.target.hasAttribute && event.target.hasAttribute("data-newsletter")) {
            gtag("event", "sign_up", { method: "newsletter", guide: guide });
          }
        });
      })();
    </script>
    <!-- Vitesse du site (Core Web Vitals : LCP, INP, CLS, FCP, TTFB), seulement après accord -->
    <script is:inline>
      window.zunrelVitals = function () {
        if (window.zunrelVitalsStarted) return;
        window.zunrelVitalsStarted = true;
        import("https://cdn.jsdelivr.net/npm/web-vitals@4/+esm")
          .then(function (wv) {
            function send(metric) {
              gtag("event", "web_vital", {
                metric_name: metric.name,
                metric_value: metric.name === "CLS" ? Math.round(metric.value * 1000) / 1000 : Math.round(metric.value),
                metric_rating: metric.rating,
                page: location.pathname,
              });
            }
            wv.onLCP(send);
            wv.onINP(send);
            wv.onCLS(send);
            wv.onFCP(send);
            wv.onTTFB(send);
          })
          .catch(function () {});
      };
      try {
        if (localStorage.getItem("zunrel-consent") === "granted") window.zunrelVitals();
      } catch (e) {}
    </script>
  </body>
</html>
