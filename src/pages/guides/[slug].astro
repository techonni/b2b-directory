---
import Base from "../../layouts/Base.astro";
import GuideRow from "../../components/GuideRow.astro";
import ToolRow from "../../components/ToolRow.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import AffiliateCta from "../../components/AffiliateCta.astro";
import NewsletterBar from "../../components/NewsletterBar.astro";
import {
  formatDate,
  getGuide,
  seoDescription,
  getRelatedGuides,
  formats,
  guideFormat,
  readingMinutes,
  getTheme,
  getTool,
  guides,
  shopifyPricingGuides,
  shopifyPricingLink,
  type Guide,
  type NewsletterTag,
  type Tool,
} from "../../lib/guides";
import { href } from "../../lib/paths";
import { imageSize } from "../../lib/image-size";
import { guideAlternates } from "../../lib/i18n";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug } }));
}

const guide = getGuide(Astro.params.slug as string) as Guide;
const theme = getTheme(guide.theme);
const tools = guide.tools
  .map((item) => ({ tool: getTool(item.slug), why: item.why }))
  .filter((item): item is { tool: Tool; why: string } => item.tool !== undefined);
const related = getRelatedGuides(guide);

const isShop = guide.theme === "boutique";
const shopHref = shopifyPricingGuides.includes(guide.slug) ? shopifyPricingLink : undefined;
// Centre d'intérêt envoyé à Mailchimp avec l'inscription.
const mainTool = guide.tools[0]?.slug;
const newsletterTag: NewsletterTag = isShop ? "shopify" : mainTool === "leadpages" ? "leadpages" : "htmlpub";
const alternates = guideAlternates(guide.slug);
const format = formats.find((item) => item.format === guideFormat(guide));
const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: guide.question,
  description: guide.summary,
  inLanguage: "fr-FR",
  step: guide.steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.text,
  })),
};
---

<Base
  title={guide.seoTitle ?? guide.question}
  description={seoDescription(guide)}
  image={`/pins/${guide.slug}.jpg`}
  type="article"
  alternates={alternates}
  breadcrumbs={[
    { name: "Accueil", path: "/" },
    { name: "Guides", path: "/guides" },
    ...(theme ? [{ name: theme.name, path: `/themes/${theme.slug}` }] : []),
    { name: guide.question },
  ]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howTo)} />
  <meta slot="head" data-pagefind-meta="summary[content]" content={guide.summary} />
  <meta slot="head" data-pagefind-meta="minutes[content]" content={String(readingMinutes(guide))} />
  <meta slot="head" data-pagefind-filter="theme[content]" content={theme?.name ?? ""} />

  <p class="print-only hidden text-[13px] leading-5 text-[#737373]">Zunrel · zunrel.com/guides/{guide.slug}/</p>
  <div data-pagefind-body>
  <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em] text-[#171717]">{guide.question}</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">{guide.intro}</p>
  <div data-pagefind-ignore class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    {
      format ? (
        <a href={href(`/formats/${format.slug}`)} class="no-print text-[13px] leading-5 text-[#737373] hover:underline">
          {format.name}
        </a>
      ) : null
    }
    <p class="text-[13px] leading-5 text-[#a0a0a0]">Lecture : {readingMinutes(guide)} min</p>
    {
      guide.publishedOn && guide.publishedOn !== guide.updatedOn ? (
        <p class="text-[13px] leading-5 text-[#a0a0a0]">Publié le {formatDate(guide.publishedOn)}</p>
      ) : null
    }
    <p class="text-[13px] leading-5 text-[#a0a0a0]">Mis à jour le {formatDate(guide.updatedOn)}</p>
    {
      alternates
        ? alternates.slice(1).map((item) => (
            <a href={item.path} hreflang={item.lang} class="no-print text-[13px] leading-5 text-[#737373] hover:underline">
              {item.lang === "pt" ? "Em português" : "In English"}
            </a>
          ))
        : null
    }
    <button
      type="button"
      data-print
      class="no-print inline-flex h-[30px] items-center gap-1.5 rounded-[4px] border border-[#e5e5e5] bg-white px-3 text-[13px] font-medium text-[#171717] hover:bg-[#f3f3f3]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
      Télécharger en PDF
    </button>
  </div>
  <script>
    document.querySelectorAll("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
  </script>

  <AffiliateCta shop={isShop} placement="haut" shopHref={shopHref} />

  <section class="mt-10 rounded-[6px] border border-[#e5e5e5] bg-white p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">
      {guideFormat(guide) === "complet" ? "Le parcours en bref" : "L'essentiel en 30 secondes"}
    </h2>
    <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-[15px] leading-6 text-[#404040]">
      {guide.steps.map((step) => <li>{step.title}</li>)}
    </ol>
    {
      guide.pitfalls[0] ? (
        <p class="mt-4 text-[14px] leading-6 text-[#666666]">
          <span class="font-medium text-[#171717]">À éviter :</span> {guide.pitfalls[0]}
        </p>
      ) : null
    }
    <a href="#etapes" data-pagefind-ignore class="no-print mt-4 inline-block text-[14px] font-medium leading-5 text-[#171717] hover:underline">
      Voir le détail avec les captures ↓
    </a>
  </section>

  <section id="etapes" class="mt-14 scroll-mt-20">
    <h2 class="text-[13px] leading-5 text-[#737373]">Étape par étape</h2>
    <ol class="mt-6 space-y-8">
      {
        guide.steps.map((step, index) => (
          <li class="flex gap-4">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#171717] text-[13px] font-medium text-white">
              {index + 1}
            </span>
            <div>
              <h3 class="text-[15px] font-medium leading-6 text-[#171717]">{step.title}</h3>
              {step.text.split("\n\n").map((paragraph, index) => (
                <p class:list={["text-[15px] leading-6 text-[#666666]", index === 0 ? "mt-1" : "mt-3"]}>{paragraph}</p>
              ))}
              {step.image ? (
                <img
                  src={step.image.src}
                  alt={step.image.alt}
                  width={imageSize(step.image.src)?.width}
                  height={imageSize(step.image.src)?.height}
                  loading="lazy"
                  decoding="async"
                  class="mt-4 w-full rounded-[6px] shadow-[0_0_0_1px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.05)]"
                />
              ) : null}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <AffiliateCta shop={isShop} placement="bas" shopHref={shopHref} />

  {
    guide.pitfalls.length > 0 ? (
      <section class="mt-14 rounded-[6px] bg-[#fff6e5] p-6">
        <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Erreurs fréquentes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-6 text-[#5c4a26]">
          {guide.pitfalls.map((pitfall) => <li>{pitfall}</li>)}
        </ul>
      </section>
    ) : null
  }

  {
    tools.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">Outils utiles</h2>
        <div class="mt-6 space-y-6">
          {tools.map((item) => <ToolRow tool={item.tool} note={item.why} />)}
        </div>
      </section>
    ) : null
  }

  {
    guide.sources.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">Sources officielles</h2>
        <ul class="mt-4 space-y-2">
          {guide.sources.map((source) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noopener"
                class="text-[15px] font-medium leading-6 text-[#171717] hover:underline"
              >
                {source.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  </div>

  <section class="no-print mt-14">
    <ShareButtons title={guide.question} slug={guide.slug} />
  </section>

  <NewsletterForm tag={newsletterTag} />
  <NewsletterBar
    gift={isShop
      ? "Recevez la checklist de lancement Shopify offerte, et les prochains guides."
      : "Recevez la checklist pour lancer votre landing page, et les prochains guides."}
  />

  {
    related.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#737373]">À lire ensuite</h2>
        <div class="mt-6 space-y-8">
          {related.map((item) => <GuideRow guide={item} />)}
        </div>
      </section>
    ) : null
  }
</Base>
