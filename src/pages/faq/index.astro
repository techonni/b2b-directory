---
import Base from "../../layouts/Base.astro";
import { guidesInTheme, themes } from "../../lib/guides";
import { href } from "../../lib/paths";

// Une question par guide, regroupées par thème. La réponse courte reprend l'introduction du guide.
const sections = themes
  .map((theme) => ({ theme, list: guidesInTheme(theme.slug) }))
  .filter((section) => section.list.length > 0);

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "fr-FR",
  mainEntity: sections.flatMap((section) =>
    section.list.map((guide) => ({
      "@type": "Question",
      name: guide.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: guide.intro,
        url: new URL(href(`/guides/${guide.slug}`), Astro.site).href,
      },
    })),
  ),
};
---

<Base
  title="Questions fréquentes"
  description="Les questions les plus posées sur Leadpages, HTML Pub et Shopify, avec une réponse courte et un guide étape par étape."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />

  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Questions fréquentes</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">
    Une réponse courte à chaque question, puis le guide complet, étape par étape.
  </p>
  {
    sections.map(({ theme, list }) => (
      <section class="mt-14">
        <a href={href(`/themes/${theme.slug}`)} class="text-[13px] leading-5 text-[#737373] hover:underline">
          {theme.name}
        </a>
        <div class="mt-5 space-y-8">
          {list.map((guide) => (
            <div>
              <h2 class="text-[15px] font-medium leading-5 text-[#171717]">{guide.question}</h2>
              <p class="mt-2 text-[15px] leading-6 text-[#666666]">{guide.intro}</p>
              <a
                href={href(`/guides/${guide.slug}`)}
                class="mt-2 inline-block text-[14px] font-medium leading-5 text-[#171717] hover:underline"
              >
                Lire le guide →
              </a>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</Base>
