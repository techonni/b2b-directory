---
import Base from "../../layouts/Base.astro";
import FormatGroups from "../../components/FormatGroups.astro";
import ToolRow from "../../components/ToolRow.astro";
import { getTheme, guidesInTheme, themes, tools, type Theme } from "../../lib/guides";

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { slug: theme.slug } }));
}

const theme = getTheme(Astro.params.slug as string) as Theme;
const list = guidesInTheme(theme.slug);
const themeTools = tools.filter((tool) => tool.themes.includes(theme.slug));
---

<Base
  title={theme.name}
  description={theme.blurb}
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Guides", path: "/guides" }, { name: theme.name }]}
>
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">{theme.name}</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">{theme.blurb}</p>

  <div class="mt-14">
    <FormatGroups guides={list} />
  </div>

  {
    themeTools.length > 0 ? (
      <section class="mt-16">
        <h2 class="text-[13px] leading-5 text-[#737373]">Outils pour ce thème</h2>
        <div class="mt-6 space-y-6">
          {themeTools.map((tool) => <ToolRow tool={tool} />)}
        </div>
      </section>
    ) : null
  }
</Base>
