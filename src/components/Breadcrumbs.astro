---
import { href } from "../lib/paths";

export type Crumb = { name: string; path?: string };

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="no-print mb-3">
  <ol class="flex flex-wrap items-center gap-x-1.5 text-[13px] leading-5 text-[#737373]">
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class="flex items-center gap-x-1.5">
            {index > 0 ? <span aria-hidden="true">›</span> : null}
            {last || !item.path ? (
              <span aria-current={last ? "page" : undefined}>{item.name}</span>
            ) : (
              <a href={href(item.path)} class="hover:underline">
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
