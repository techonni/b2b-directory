# Google Analytics
# Get your Measurement ID from Google Analytics 4
# Format: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mailchimp Newsletter
# Get these from your Mailchimp account settings
# API Key: Account → Extras → API Keys
# List ID: Audience → Manage Audience → Settings
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_LIST_ID=your_mailchimp_list_id_here
