---
// Newsletter signup form with Mailchimp integration
// Uses environment variable: MAILCHIMP_API_KEY and MAILCHIMP_LIST_ID
---

<div class="rounded-[6px] bg-[#f3f3f3] p-6">
  <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Recebe os próximos guias</h2>
  <p class="mt-2 text-[14px] leading-6 text-[#666666]">
    Novos guias sobre Leadpages, HTML Pub e Shopify, diretos na tua inbox.
  </p>

  <form id="newsletter-form" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-2">
    <div class="flex-1">
      <label for="newsletter-email" class="sr-only">Email</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="teu@email.com"
        required
        class="h-[39px] w-full rounded-[4px] bg-white px-3 text-[14px] text-[#171717] outline-none placeholder:text-[#a0a0a0] focus:ring-2 focus:ring-[#171717]"
      />
    </div>
    <button
      type="submit"
      class="h-[39px] rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black transition-colors"
    >
      Subscrever
    </button>
  </form>

  <div id="newsletter-message" class="mt-3 hidden text-[13px]"></div>

  <p class="mt-3 text-[12px] leading-4 text-[#a0a0a0]">
    Sem spam. Apenas guias úteis. Podes desinscrever-te a qualquer momento.
  </p>
</div>

<script>
  const form = document.getElementById("newsletter-form");
  const messageEl = document.getElementById("newsletter-message");
  const emailInput = document.getElementById("newsletter-email") as HTMLInputElement;

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = emailInput.value.trim();
      if (!email) return;

      const button = form.querySelector("button") as HTMLButtonElement;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = "A enviar...";

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (response.ok) {
          messageEl.textContent = "✓ Subscrição confirmada! Verifica o teu email.";
          messageEl.className = "mt-3 block text-[13px] text-green-600";
          emailInput.value = "";
          form.style.display = "none";
        } else {
          messageEl.textContent = data.error || "Erro ao subscrever. Tenta novamente.";
          messageEl.className = "mt-3 block text-[13px] text-red-600";
        }
      } catch (error) {
        messageEl.textContent = "Erro de conexão. Tenta novamente.";
        messageEl.className = "mt-3 block text-[13px] text-red-600";
      } finally {
        button.disabled = false;
        button.textContent = originalText;
      }
    });
  }
</script>
