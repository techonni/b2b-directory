---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "A directory of B2B software",
  description = "A directory of B2B software, curated by Your Name.",
} = Astro.props;

const documentTitle = title.includes("·") || title.startsWith("A directory")
  ? title
  : `${title} · Directory`;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-full bg-[#fbfbfb] text-[#171717]">
    <SiteHeader />
    <div class="mx-auto w-full max-w-[580px] px-5 min-[620px]:px-0">
      <main class="pt-20">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
