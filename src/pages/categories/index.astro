---
import Base from "../../layouts/Base.astro";
import { categories, toolCount } from "../../lib/directory";
import { href } from "../../lib/paths";
---

<Base title="Categories" description="Browse the directory by the job the software does.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">Categories</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#737373]">
    Browse the directory by the job the software does.
  </p>
  <div class="mt-16 space-y-10">
    {
      categories.map((category) => {
        const count = toolCount(category.slug);
        return (
          <a href={href(`/categories/${category.slug}`)} class="group block">
            <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
              {category.name} →
            </span>
            <span class="mt-1 block text-[14px] leading-5 text-[#737373]">
              {category.blurb} {count} {count === 1 ? "tool" : "tools"}.
            </span>
          </a>
        );
      })
    }
  </div>
</Base>
