---
// Inscription à la newsletter avec le formulaire « embedded » de Mailchimp.
// Pas de clé API ni de serveur : le formulaire envoie directement à Mailchimp,
// qui gère la confirmation par e-mail (double opt-in).
// Le script envoie l'adresse en arrière-plan (point d'accès JSONP « post-json » de Mailchimp) :
// le visiteur reste sur la page et voit le message ici. Si Mailchimp ne répond pas,
// le formulaire est envoyé normalement dans un nouvel onglet.
// Le bloc ne s'affiche que si `newsletterFormUrl` est rempli dans src/lib/guides.ts.
import { newsletterFormUrl, newsletterHoneypot } from "../lib/guides";
---

{
  newsletterFormUrl ? (
    <section class="no-print mt-14 rounded-[6px] bg-[#f3f3f3] p-6">
      <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Recevoir les prochains guides</h2>
      <p class="mt-3 text-[14px] leading-6 text-[#666666]">
        Les nouveaux guides Leadpages, HTML Pub et Shopify par e-mail. Pas de spam, désinscription en un clic.
      </p>
      <form
        action={newsletterFormUrl}
        method="post"
        target="_blank"
        data-newsletter
        class="mt-5 flex flex-col gap-2 min-[480px]:flex-row"
      >
        <label for="newsletter-email" class="sr-only">Adresse e-mail</label>
        <input
          id="newsletter-email"
          type="email"
          name="EMAIL"
          required
          autocomplete="email"
          placeholder="vous@exemple.com"
          class="h-[39px] flex-1 rounded-[4px] bg-white px-3 text-[14px] text-[#171717] outline-none placeholder:text-[#a0a0a0] focus:ring-2 focus:ring-[#171717]"
        />
        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name={newsletterHoneypot} tabindex="-1" value="" />
        </div>
        <button type="submit" class="h-[39px] rounded-[4px] bg-[#262626] px-6 text-[14px] font-medium text-white hover:bg-black disabled:opacity-60">
          S'inscrire
        </button>
      </form>
      <p data-newsletter-message role="status" class="mt-3 text-[13px] leading-5 text-[#a0a0a0]">
        Vous recevrez un e-mail pour confirmer votre inscription.
      </p>
    </section>
  ) : null
}

<script is:inline>
  (function () {
    var form = document.querySelector("form[data-newsletter]");
    if (!form) return;
    var message = document.querySelector("[data-newsletter-message]");
    var button = form.querySelector('button[type="submit"]');

    function show(text, isError) {
      message.textContent = text;
      message.style.color = isError ? "#b42318" : "#171717";
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      var name = "zunrelNewsletter" + Date.now();
      var url = form.action.replace("/subscribe/post?", "/subscribe/post-json?");
      var params = new URLSearchParams(new FormData(form));
      params.set("c", name);
      var script = document.createElement("script");
      var done = false;

      function cleanup() {
        done = true;
        button.disabled = false;
        delete window[name];
        script.remove();
      }

      // Si Mailchimp ne répond pas, on envoie le formulaire classique (nouvel onglet).
      var fallback = setTimeout(function () {
        if (done) return;
        cleanup();
        show("Terminez votre inscription dans l'onglet qui vient de s'ouvrir.", false);
        form.submit();
      }, 8000);

      window[name] = function (data) {
        clearTimeout(fallback);
        cleanup();
        if (data && data.result === "success") {
          form.reset();
          show("Presque fini : ouvrez l'e-mail que nous venons d'envoyer et cliquez sur le bouton pour confirmer.", false);
        } else if (data && /already subscribed|déjà inscrit/i.test(data.msg || "")) {
          show("Cette adresse est déjà inscrite. Merci !", false);
        } else {
          show("L'inscription n'a pas fonctionné. Vérifiez l'adresse e-mail et réessayez.", true);
        }
      };

      button.disabled = true;
      show("Inscription en cours…", false);
      script.src = url + "&" + params.toString();
      script.onerror = function () {
        if (done) return;
        clearTimeout(fallback);
        cleanup();
        show("Terminez votre inscription dans l'onglet qui vient de s'ouvrir.", false);
        form.submit();
      };
      document.body.appendChild(script);
    });
  })();
</script>
