{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/outils/yousign/",
      "destination": "/outils/youtrust/",
      "permanent": true
    },
    {
      "source": "/outils/yousign",
      "destination": "/outils/youtrust/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/logos/henrri.png",
      "destination": "https://www.henrri.com/wp-content/themes/chouette-template/icons/apple-icon-180x180.png"
    },
    {
      "source": "/logos/abby.png",
      "destination": "https://abby.fr/favicon-32x32.png"
    },
    {
      "source": "/logos/freebe.jpg",
      "destination": "https://cdn.prod.website-files.com/5d874b54ad1d4bcf0eff06d5/5e146f8b2c2877f75bbe5a02_freebe_logo.jpg"
    },
    {
      "source": "/logos/tiime.png",
      "destination": "https://www.tiime.fr/hubfs/Tiime%20Theme%202022/Logos/tiime-favicon-test-480x480-1.png"
    },
    {
      "source": "/logos/indy.png",
      "destination": "https://www.indy.fr/wp-content/themes/hello-child/favicon/apple-touch-icon.png"
    },
    {
      "source": "/logos/shine.png",
      "destination": "https://www.shine.fr/icons/icon-512x512.png"
    },
    {
      "source": "/logos/qonto.png",
      "destination": "https://qonto.com/blog/assets/apple-touch-icon-4d8a168a3ba8d53fa08beaf4d665da32d9a43f49b88fa9f08d3017e23663ef53.png"
    },
    {
      "source": "/logos/sumup.png",
      "destination": "https://static.sumup.com/favicons/apple-touch-icon.png"
    },
    {
      "source": "/logos/stripe.png",
      "destination": "https://images.stripeassets.com/fzn2n1nzq965/4vVgZi0ZMoEzOhkcv7EVwK/8cce6fdcf2733b2ec8e99548908847ed/favicon.png"
    },
    {
      "source": "/logos/paypal.png",
      "destination": "https://www.paypalobjects.com/marketing/web/icons/monogram/pp258.png"
    },
    {
      "source": "/logos/youtrust.png",
      "destination": "https://youtrust.com/apple-touch-icon.png"
    },
    {
      "source": "/logos/google-business-profile.png",
      "destination": "https://business.google.com/static/images/google-favicon-180.png"
    },
    {
      "source": "/logos/carrd.svg",
      "destination": "https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/carrd.svg"
    },
    {
      "source": "/logos/calendly.png",
      "destination": "https://calendly.com/media/favicon/apple-touch-icon.png"
    }
  ]
}
