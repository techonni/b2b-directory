---
// Page d'arrivée après la confirmation d'inscription (redirection réglée dans Mailchimp).
import Base from "../../layouts/Base.astro";
import { guides } from "../../lib/guides";

const gifts = [
  { href: "/newsletter/checklist-shopify/", label: "Checklist de lancement Shopify", text: "Les 10 étapes à cocher avant d'ouvrir votre boutique." },
  { href: "/newsletter/checklist-leadpages/", label: "Checklist : lancer sa première landing page", text: "Les 10 étapes pour une page Leadpages ou HTML Pub qui récolte des contacts." },
  { href: "/newsletter/modeles-landing-page/", label: "Modèles de textes pour landing page", text: "Titres, boutons, formulaire et remerciement, à copier et compléter." },
];
const latest = [...guides].sort((a, b) => b.updatedOn.localeCompare(a.updatedOn)).slice(0, 3);
---

<Base title="Inscription confirmée" description="Votre inscription à la newsletter Zunrel est confirmée.">
  <h1 class="text-[22px] font-semibold leading-7 text-[#171717]">C'est confirmé, merci !</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">
    Vous recevrez les prochains guides Leadpages, HTML Pub et Shopify par e-mail. Vous pouvez vous désinscrire à tout
    moment, en un clic, depuis chaque e-mail.
  </p>
  <p class="mt-4 text-[15px] leading-6 text-[#666666]">
    Pour ne pas manquer nos e-mails, ajoutez <strong class="font-medium text-[#171717]">contact@zunrel.com</strong> à
    vos contacts. Si un e-mail arrive dans les indésirables, marquez-le comme « Pas un spam ».
  </p>
  <section class="mt-10 rounded-[6px] bg-[#f3f3f3] p-6">
    <h2 class="text-[15px] font-medium leading-5 text-[#171717]">Vos cadeaux</h2>
    <p class="mt-3 text-[14px] leading-6 text-[#666666]">
      À imprimer ou enregistrer en PDF, selon votre projet.
    </p>
    <ul class="mt-4 space-y-3">
      {
        gifts.map((gift) => (
          <li>
            <a href={gift.href} class="text-[15px] font-medium leading-6 text-[#171717] underline underline-offset-4 hover:text-black">
              {gift.label}
            </a>
            <span class="block text-[14px] leading-6 text-[#666666]">{gift.text}</span>
          </li>
        ))
      }
    </ul>
  </section>
  <h2 class="mt-10 text-[15px] font-medium leading-5 text-[#171717]">En attendant, les derniers guides</h2>
  <ul class="mt-4 space-y-3 text-[15px] leading-6">
    {
      latest.map((guide) => (
        <li>
          <a href={`/guides/${guide.slug}/`} class="text-[#171717] underline underline-offset-4 hover:text-black">
            {guide.question}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 text-[15px] leading-6">
    <a href="/guides/" class="text-[#171717] underline underline-offset-4 hover:text-black">Voir tous les guides</a>
  </p>
</Base>
