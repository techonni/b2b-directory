---
import TranslatedGuidePage from "../../../components/TranslatedGuidePage.astro";
import { translations, type TranslatedGuide } from "../../../lib/i18n";

export function getStaticPaths() {
  return translations.en.map((item) => ({ params: { slug: item.localSlug }, props: { item } }));
}

const { item } = Astro.props as { item: TranslatedGuide };
---

<TranslatedGuidePage lang="en" item={item} />
