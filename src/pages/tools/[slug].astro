---
import Base from "../../layouts/Base.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import ToolRow from "../../components/ToolRow.astro";
import {
  categoryNames,
  formatChecked,
  getTool,
  tools,
  type Tool,
} from "../../lib/directory";
import { href } from "../../lib/paths";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { slug: tool.slug },
  }));
}

interface Props {
  slug: string;
}

const tool = getTool(Astro.props.slug) as Tool;
const categories = categoryNames(tool.categories);
const review = tool.review;
const alternatives = (review?.alternatives ?? [])
  .map((alternative) => getTool(alternative))
  .filter((alternative): alternative is Tool => alternative !== undefined);

const sections = review
  ? [
      ["What it does", review.whatItDoes],
      ["Who it's for", review.whoItsFor],
      ["Strengths", review.strengths],
      ["Weaknesses", review.weaknesses],
      ["Verdict", review.verdict],
    ]
  : [];
---

<Base title={tool.name} description={tool.summary}>
  <BrandIcon slug={tool.slug} name={tool.name} />
  <h1 class="mt-6 text-[22px] font-semibold leading-7 text-[#171717]">{tool.name}</h1>
  <p class="mt-3 text-[15px] leading-6 text-[#737373]">{tool.summary}</p>

  <h2 class="mt-16 text-[13px] leading-5 text-[#737373]">Details</h2>
  <p class="mt-6 text-[15px] font-semibold leading-6 text-[#171717]">
    Categories:{" "}
    {
      categories.map((category, index) => (
        <span>
          {index > 0 ? ", " : null}
          <a href={href(`/categories/${category.slug}`)} class="hover:underline">
            {category.name}
          </a>
        </span>
      ))
    }
  </p>
  {
    review ? (
      <>
        <p class="mt-4 text-[15px] leading-6 text-[#737373]">{review.pricing}</p>
        <p class="mt-4 text-[14px] leading-5 text-[#737373]">
          Checked on {formatChecked(review.checkedOn)}.
        </p>
      </>
    ) : (
      <p class="mt-4 text-[15px] leading-6 text-[#737373]">
        This tool is listed in the directory. A full note has not been added yet.
      </p>
    )
  }
  <div class="mt-6 flex flex-col gap-3">
    {
      tool.pricingUrl ? (
        <a
          href={tool.pricingUrl}
          target="_blank"
          rel="noreferrer"
          class="text-[15px] font-medium leading-5 text-[#171717] hover:underline"
        >
          Pricing page →
        </a>
      ) : null
    }
    <a
      href={tool.website}
      target="_blank"
      rel="noreferrer"
      class="text-[15px] font-medium leading-5 text-[#171717] hover:underline"
    >
      Official site →
    </a>
  </div>

  {
    sections.map(([label, copy]) => (
      <section class="mt-12">
        <h2 class="text-[13px] leading-5 text-[#737373]">{label}</h2>
        <p class="mt-4 text-[15px] leading-6 text-[#737373]">{copy}</p>
      </section>
    ))
  }

  {
    alternatives.length > 0 ? (
      <section class="mt-12">
        <h2 class="text-[13px] leading-5 text-[#737373]">Alternatives</h2>
        <div class="mt-6 space-y-6">
          {alternatives.map((alternative) => (
            <ToolRow tool={alternative} />
          ))}
        </div>
      </section>
    ) : null
  }
</Base>
