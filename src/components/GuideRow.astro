---
import { href } from "../lib/paths";
import type { Guide } from "../lib/guides";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
---

<a href={href(`/guides/${guide.slug}`)} class="group block">
  <span class="block text-[15px] font-medium leading-5 text-[#171717] group-hover:underline">
    {guide.question} →
  </span>
  <span class="mt-1 block text-[14px] leading-5 text-[#737373]">{guide.summary}</span>
</a>
